{
  "name": "net.foratier.karaoke",
  "private": true,
  "version": "1.0.0",
  "description": "Karaoke on both sides of your BUSY Bar: lyrics in sync, public-domain songs",
  "author": "Julien Foratier",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-busy-cli.mjs",
    "songs": "node scripts/songs.mjs",
    "sync": "node scripts/sync.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "typecheck": "tsc",
    "build": "busy-cli build",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop",
    "changelog": "node scripts/changelog.mjs check",
    "preview": "node scripts/preview.mjs"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "devDependencies": {
    "@busy-app/cli": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.21.1"
  }
}
